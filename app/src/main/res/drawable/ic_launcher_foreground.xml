<?xml version="1.0" encoding="utf-8"?>
<!-- Four arrows pointing inward at a small frame: "shrink".
     Standard 108dp adaptive canvas, content inside the 72dp safe zone.

     Each arrow is a diagonal shaft plus a triangular head aimed at the centre. An
     earlier version placed the arrows on the vertical and horizontal axes with
     overlapping bounds; rasterised, they merged into two solid blobs rather than
     reading as arrows. Diagonals with clear gaps are what make the shape legible at
     launcher size. The heads are symmetric about each shaft's own diagonal, so they
     meet the shaft cleanly instead of leaving a notch. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centre frame: the small result everything points at. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,45 h18 v18 h-18 z" />

    <!-- Shafts, from each corner toward the centre. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:pathData="M25,25 L33,33" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:pathData="M83,25 L75,33" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:pathData="M25,83 L33,75" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:pathData="M83,83 L75,75" />

    <!-- Heads: triangles pointing inward along each diagonal. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,42 L42,29 L29,42 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M66,42 L66,29 L79,42 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,66 L42,79 L29,66 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M66,66 L66,79 L79,66 Z" />
</vector>
