<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon: four arrows converging on a small frame.

     Same meaning as the launcher mark in ic_launcher_foreground.xml, but deliberately
     NOT a scaled copy of it. A status-bar icon is drawn around 24dp and flattened to a
     single colour, so the launcher's thin shafts and small heads render as pale specks.
     Rendering both at 24px side by side made that obvious: the shapes here are the same
     idea at roughly double the visual weight.

     Note the direction. The icon this replaced had bold arrows pointing OUTWARD, which
     reads as "expand" — the opposite of what the app does. The arrows point inward.

     Both files must be edited together if the mark changes; they are checked by eye at
     their real sizes, because the two contexts genuinely need different proportions. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Centre frame: the small result everything points at. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9.6,9.6 h4.8 v4.8 h-4.8 z" />

    <!-- Top-left arrow: solid barbed head plus a thick shaft back to the corner.
         Drawn as one closed path so there is no seam between head and shaft. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.6,2.6 L8.1,2.6 L6.2,4.5 L8.4,6.7 L6.7,8.4 L4.5,6.2 L2.6,8.1 Z" />

    <!-- Top-right -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21.4,2.6 L21.4,8.1 L19.5,6.2 L17.3,8.4 L15.6,6.7 L17.8,4.5 L15.9,2.6 Z" />

    <!-- Bottom-left -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.6,21.4 L2.6,15.9 L4.5,17.8 L6.7,15.6 L8.4,17.3 L6.2,19.5 L8.1,21.4 Z" />

    <!-- Bottom-right -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M21.4,21.4 L15.9,21.4 L17.8,19.5 L15.6,17.3 L17.3,15.6 L19.5,17.8 L21.4,15.9 Z" />
</vector>
